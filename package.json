{
  "name": "fleet-vision",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w web-dashboard\" \"npm run dev -w data-processor\"",
    "dev:all": "concurrently \"npm run dev -w web-dashboard\" \"npm run dev -w tcp-server\" \"npm run dev -w data-processor\"",
    "dev:tcp": "npm run dev -w tcp-server",
    "dev:processor": "npm run dev -w data-processor",
    "dev:dashboard": "npm run dev -w web-dashboard",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "npm run db:generate -w @fleet-vision/db",
    "db:push": "npm run db:push -w @fleet-vision/db",
    "db:migrate": "npm run db:migrate -w @fleet-vision/db",
    "db:studio": "npm run db:studio -w @fleet-vision/db",
    "infra:up": "docker compose up -d postgres redis kafka",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f postgres redis kafka",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:push": "docker compose push",
    "docker:local:up": "docker compose up -d",
    "docker:local:down": "docker compose down",
    "docker:local:logs": "docker compose logs -f",
    "docker:local:build": "docker compose build",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml up -d",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "docker:prod:logs": "docker compose -f docker-compose.prod.yml logs -f",
    "docker:prod:build": "docker compose -f docker-compose.prod.yml build",
    "docker:prod:push": "docker compose -f docker-compose.prod.yml push"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "turbo": "^2.5.0"
  },
  "packageManager": "npm@10.8.0"
}
