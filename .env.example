# ─── PostgreSQL (TimescaleDB) ─────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fleet_vision?schema=public"

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Kafka ────────────────────────────────────────────────────
KAFKA_BROKERS="localhost:9092"
KAFKA_TOPIC="telemetry-raw"

# ─── Go TCP Gateway ──────────────────────────────────────────
TCP_PORT="8500"
