# ─── PostgreSQL (Relational Data / Primary DB) ─────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fleet_vision?schema=public"

# ─── TimescaleDB (Optional in local dev, falls back to DATABASE_URL)
# Set this in production if you host TimescaleDB on a separate instance from AWS RDS:
# TIMESCALE_URL="postgresql://postgres:postgres@localhost:5432/fleet_vision?schema=public"

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Kafka ────────────────────────────────────────────────────
KAFKA_BROKERS="localhost:9092"
KAFKA_TOPIC="telemetry-raw"

# ─── Go TCP Gateway ──────────────────────────────────────────
TCP_PORT="8500"

# ─── Auth / Security ─────────────────────────────────────────
JWT_SECRET="local_dev_super_secret_key_at_least_32_characters"

