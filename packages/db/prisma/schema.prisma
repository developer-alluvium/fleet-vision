// ─── Prisma Schema ──────────────────────────────────────────
// Fleet Vision Enterprise — Multi-Tenant Telemetry Data Model
//
// Run `npx prisma generate` to generate the client after editing.
// Run `npx prisma db push` to sync with the database.
// Run `npx prisma migrate dev` for production-style migrations.
// ─────────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

/// A tenant organization — all resources are scoped to this entity.
model Organization {
  id                  String    @id @default(cuid())
  name                String
  status              String    @default("ACTIVE") // ACTIVE, SUSPENDED, CANCELLED
  subscriptionPlan    String    @default("TRIAL") @map("subscription_plan")
  subscriptionEndDate DateTime? @map("subscription_end_date")
  stripeCustomerId    String?   @map("stripe_customer_id")
  apiKey              String?   @unique @map("api_key")

  users     User[]
  devices   Device[]
  vehicles  Vehicle[]
  geofences Geofence[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("organizations")
}

/// A user belonging to an organization.
model User {
  id             String       @id @default(cuid())
  email          String       @unique
  password       String?
  role           String       @default("ADMIN") // ADMIN, MANAGER, VIEWER
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]

  @@map("users")
}

/// A registered GPS tracking device (identified by its unique IMEI).
model Device {
  id             String       @id @default(cuid())
  imei           String       @unique
  status         String       @default("PENDING_CONNECTION") // PENDING_CONNECTION, ONLINE, OFFLINE
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicleId      String?      @unique @map("vehicle_id")
  vehicle        Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("devices")
}

/// A vehicle linked to a tracking device.
model Vehicle {
  id              String       @id @default(cuid())
  plateNumber     String       @unique @map("plate_number")
  make            String?
  model           String?
  year            Int?
  color           String?
  vin             String?      @unique
  vehicleType     String?      @map("vehicle_type") // CAR, TRUCK, VAN, etc.
  status          String       @default("ACTIVE") // ACTIVE, MAINTENANCE, INACTIVE
  fuelType        String?      @map("fuel_type") // PETROL, DIESEL, ELECTRIC, HYBRID
  maxFuelCapacity Float?       @map("max_fuel_capacity")
  organizationId  String       @map("organization_id")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  device          Device?

  // ── BLE Fuel Sensor ─────────────────────────────────────
  bleFuelChannel               Int?     @map("ble_fuel_channel")             // 1–4 (which BLE sensor)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("vehicles")
}

/// A geofence polygon with PostGIS spatial indexing.
model Geofence {
  id             String       @id @default(cuid())
  name           String
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// PostGIS Polygon + GiST Index for high-performance spatial queries
  polygon Unsupported("geometry(Polygon, 4326)")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([polygon], type: Gist)
  @@map("geofences")
}

/// A single telemetry data point received from a device.
/// This table is converted to a TimescaleDB Hypertable keyed on `time`.
model TelemetryRecord {
  id              String   @default(cuid())
  time            DateTime @default(now()) @db.Timestamptz
  imei            String
  organizationId  String   @map("organization_id")
  latitude        Float?
  longitude       Float?
  speed           Float?
  angle           Float?
  ignition               Boolean  @default(false)
  
  // Extracted IO Elements
  gsmSignal              Int?     @map("gsm_signal")
  externalVoltage        Int?     @map("external_voltage")
  internalBatteryVoltage Int?     @map("internal_battery_voltage")
  gnssStatus             Int?     @map("gnss_status")
  batteryLevel           Int?     @map("battery_level")
  movement               Boolean?

  // ── BLE Fuel Sensor Data ──────────────────────────────
  fuelLevelRaw           Int?     @map("fuel_level_raw")         // IO 270/273/276/279 raw value

  serverCreatedAt        DateTime @default(now()) @map("server_created_at") @db.Timestamptz

  @@id([id, time])
  @@index([time(sort: Desc)])
  @@index([imei, time(sort: Desc)])
  @@index([organizationId, time(sort: Desc)])
  @@map("telemetry_records")
}

/// A refresh token for a user session
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("refresh_tokens")
}
