# ==============================================================================
# Fleet Vision — Production Environment Configuration (.env.production)
# ==============================================================================
# Copy this file to .env.production on your production server:
#   cp .env.production.example .env.production
# Fill in your production infrastructure credentials below.
# ==============================================================================

# ─── Production PostgreSQL (AWS RDS) ──────────────────────────
# Connection string pointing to managed relational database (AWS RDS PostgreSQL)
# Stores organizations, users, devices, vehicles, geofences, alerts
DATABASE_URL="postgresql://postgres:YOUR_PROD_RDS_PASSWORD@YOUR_PROD_RDS_HOST:5432/fleet_vision?schema=public&sslmode=prefer"

# ─── Production TimescaleDB (Self-Hosted on EC2) ──────────────
# Dedicated connection string pointing to self-hosted TimescaleDB on EC2
# Stores time-series GPS telemetry records (telemetry_records hypertable)
TIMESCALE_URL="postgresql://postgres:YOUR_EC2_TIMESCALE_PASSWORD@localhost:5432/fleet_vision?schema=public"

# ─── Production Redis ─────────────────────────────────────────
# Connection string pointing to managed Redis (e.g. AWS ElastiCache / Redis Cloud)
# Format: redis://[:password@]host:port[/db] or rediss:// for SSL
REDIS_URL="redis://YOUR_PROD_REDIS_HOST:6379"

# ─── Production Apache Kafka ──────────────────────────────────
# Comma-separated list of Kafka broker endpoints (e.g. AWS MSK / Confluent Cloud / EC2 Kafka)
KAFKA_BROKERS="YOUR_PROD_KAFKA_HOST:9092"
KAFKA_TOPIC="telemetry-raw"
CONSUMER_GROUP="data-processor-group"

# ─── Web API & Authentication ─────────────────────────────────
PORT=3000
# Generate secure keys (e.g. `openssl rand -base64 32`)
JWT_SECRET="replace_with_a_secure_random_string_min_32_characters"
ACCESS_TOKEN_SECRET="replace_with_a_secure_random_string_for_access_token"
REFRESH_TOKEN_SECRET="replace_with_a_secure_random_string_for_refresh_token"

# ─── Data Retention & Workers ─────────────────────────────────
ENABLE_COLD_STORAGE=false
RETENTION_MONTHS=6
STALE_THRESHOLD_MINUTES=5
INACTIVE_THRESHOLD_HOURS=24
