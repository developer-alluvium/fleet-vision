# ==============================================================================
# Fleet Vision — Production Environment (.env.production)
# ==============================================================================
# Copy to .env.production on your EC2 server and fill in real values:
#   cp .env.production.example .env.production
# This file is gitignored. NEVER commit production secrets.
# ==============================================================================

# ─── AWS RDS PostgreSQL (Relational Data) ─────────────────────
# Organizations, users, devices, vehicles, geofences, alerts, etc.
DATABASE_URL="postgresql://postgres:YOUR_RDS_PASSWORD@your-rds-instance.rds.amazonaws.com:5432/fleet_vision?schema=public&sslmode=prefer"

# ─── TimescaleDB Container Credentials ────────────────────────
# Used by docker-compose.prod.yml to configure the TimescaleDB container
# The actual TIMESCALE_URL is constructed in docker-compose.prod.yml using these values
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ─── Redis (AWS ElastiCache or self-hosted) ───────────────────
REDIS_URL="redis://your-elasticache-endpoint:6379"

# ─── Kafka (AWS MSK or self-hosted) ──────────────────────────
KAFKA_BROKERS="your-kafka-broker:9092"
KAFKA_TOPIC="telemetry-raw"
CONSUMER_GROUP="data-processor-group"

# ─── Web API & Authentication ─────────────────────────────────
PORT=3000
# Generate secure keys: openssl rand -base64 32
JWT_SECRET="CHANGE_ME_generate_with_openssl_rand"
ACCESS_TOKEN_SECRET="CHANGE_ME_generate_with_openssl_rand"
REFRESH_TOKEN_SECRET="CHANGE_ME_generate_with_openssl_rand"

# ─── Data Retention & Workers ─────────────────────────────────
ENABLE_COLD_STORAGE=false
RETENTION_MONTHS=6
STALE_THRESHOLD_MINUTES=5
INACTIVE_THRESHOLD_HOURS=24
ARCHIVE_DIR="/app/archives"
